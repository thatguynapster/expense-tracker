# Copy this file to .env and fill in real values. Never commit .env.
#
# Both vars must use the EXPO_PUBLIC_ prefix to be available at runtime in
# the Expo app (Expo only inlines env vars with this prefix into the built
# bundle). Sync is treated as unconfigured — a silent no-op, not a crash —
# when either var is missing.

# The folio-server deployment URL (no trailing slash), e.g. your Vercel URL.
EXPO_PUBLIC_SYNC_SERVER_URL="https://your-folio-server.vercel.app"

# Must match SYNC_API_KEY set on folio-server. Note this value ships inside
# the compiled app bundle and can be extracted from any built APK — this is
# a known limitation of the shared-secret approach, accepted for a
# single-user personal app rather than building full auth.
EXPO_PUBLIC_SYNC_API_KEY="replace-with-the-same-secret-as-folio-server"
